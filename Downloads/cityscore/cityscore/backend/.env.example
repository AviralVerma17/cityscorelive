# Copy this file to .env and fill in what you need.
# Nothing here is required to run the app — without the two API keys
# below, the environment service automatically falls back to a
# deterministic seed generator so the product still works end to end.

NODE_ENV=development
PORT=4000

# SQLite file path (relative to where the process is started)
DB_FILE=./data/cityscore.db

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# General API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Submission-specific rate limit (per IP, on top of the per-city throttle)
SUBMISSION_RATE_LIMIT_WINDOW_MS=3600000
SUBMISSION_RATE_LIMIT_MAX=3

# Leave both blank to run in seed mode (no outbound calls).
# Set both to switch the environment service to live data.
OPENWEATHER_API_KEY=
AQICN_API_KEY=

# How often (minutes) to refresh weather/AQI for every city
ENVIRONMENT_REFRESH_MINUTES=20

LOG_LEVEL=info
